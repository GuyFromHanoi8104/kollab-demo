# Copy to .env and fill in. Everything here is exposed to the browser by
# design -- Vite inlines any VITE_-prefixed variable into the bundle, so a
# secret must NEVER be added to this file or to .env.
#
# App secrets (Meta App Secret, TikTok Client Secret) belong only in
# Supabase -> Project Settings -> Edge Functions -> Secrets, where the
# Edge Functions read them server-side.
#
# Production values live in Vercel -> Settings -> Environment Variables.
# A variable added there needs a redeploy before the bundle picks it up.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Instagram API with Instagram Login. This is the INSTAGRAM app id from
# Instagram > API setup with Instagram login -- not the Facebook App ID.
VITE_INSTAGRAM_APP_ID=
# Optional. Defaults to <origin>/instagram/callback, which is what should be
# registered in the app dashboard.
VITE_INSTAGRAM_REDIRECT_URI=
# Optional. Defaults to instagram_business_basic.
VITE_INSTAGRAM_SCOPES=

# TikTok Login Kit. The Client Key is public; the Client Secret is not and
# does not belong in this file.
VITE_TIKTOK_CLIENT_KEY=
# Optional. Defaults to <origin>/tiktok/callback.
VITE_TIKTOK_REDIRECT_URI=
# Optional. Defaults to user.info.basic,user.info.stats -- the minimum that
# returns follower_count. Every extra scope has to be demonstrated in the App
# Review screencast, so don't widen this casually.
VITE_TIKTOK_SCOPES=
